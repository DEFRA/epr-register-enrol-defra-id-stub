# Copy to .env and adjust for local development (.env is gitignored)

PORT=3200
NODE_ENV=development

# Base URL browsers use to reach the stub; also the token issuer.
STUB_EXTERNAL_URL=http://localhost:3200
# Base URL the Operator Journey frontend server uses for /token and the JWKS.
# Defaults to STUB_EXTERNAL_URL.
# STUB_INTERNAL_URL=

# The Operator Journey frontend (epr-register-enrol-frontend). These must match
# its DEFRA_ID_CLIENT_ID, DEFRA_ID_CLIENT_SECRET and AUTH_CALLBACK_BASE_URL.
# OJ_CLIENT_ID=epr-register-enrol-frontend
# OJ_CLIENT_SECRET=operator-journey-stub-secret
# CALLBACK_OJ_URL=http://localhost:3000

# Permanent stub users. Unset means none: register users through the stub.
USERS_FILE_PATH=./data/local/users.json
# Milliseconds a registration is kept. Default 259200000 (3 days).
# REGISTRATIONS_STORE_TTL=259200000
